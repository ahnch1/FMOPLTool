<Project Sdk="Microsoft.NET.Sdk">
  <!--
    안드로이드 Jukebox (개인 태블릿용). Windows 프로그램과 따로: FMOPLTools.sln에 넣지 않고 FMOPLTools.Android.sln으로 빌드한다.
    준비: dotnet workload install android (+ InstallAndroidDependencies, docs/android.md)
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>AdlibComposer.Droid</RootNamespace>
    <AssemblyName>FMOPLJukebox</AssemblyName>
    <ApplicationId>net.fmopltool.jukebox</ApplicationId>
    <ApplicationTitle>FMOPL Jukebox</ApplicationTitle>
    <!-- 버전 = Directory.Build.props의 Version (2.3.29 → 표시 2.3.29, 번호 2003029) -->
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($([System.Version]::Parse($(Version)).Major), 1000000)), $([MSBuild]::Multiply($([System.Version]::Parse($(Version)).Minor), 1000)))), $([System.Version]::Parse($(Version)).Build)))</ApplicationVersion>
    <!-- 우리 어셈블리는 줄이지 않는다 (형식 등록 · 엔진을 리플렉션 걱정 없이) -->
    <TrimMode>partial</TrimMode>
    <!-- 태블릿 = arm64. 에뮬레이터 시험용 x64도 -->
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <!-- Debug APK도 어셈블리를 APK 안에 (빠른 배포 끔): APK 파일만 태블릿에 복사해 설치해도 돈다 -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>
  <!-- Release: 전부 미리 컴파일 (AOT) — 칩 · CPU 에뮬레이션이 JIT 준비 없이 바로 빠르게. APK는 커진다 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <!--
    서명 키 (저장소에 넣지 않음): 이 폴더에 signing.local.props가 있으면 그 키로 서명 (docs/android.md). 없으면 이 PC의 디버그 키.
    두 PC에서 만든 APK를 덮어 설치하려면 같은 키를 써야 한다.
  -->
  <Import Project="signing.local.props" Condition="Exists('signing.local.props')" />
  <!-- SDK · JDK 위치: 따로 정하지 않았으면 InstallAndroidDependencies로 받은 사용자 폴더 -->
  <PropertyGroup>
    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == '' And '$(ANDROID_HOME)' == '' And Exists('$(LOCALAPPDATA)\Android\Sdk')">$(LOCALAPPDATA)\Android\Sdk</AndroidSdkDirectory>
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' And '$(JAVA_HOME)' == '' And Exists('$(LOCALAPPDATA)\Android\jdk')">$(LOCALAPPDATA)\Android\jdk</JavaSdkDirectory>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AdlibComposer.Player\AdlibComposer.Player.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 프로그램 리소스 (Windows 실행 폴더\resource와 같은 파일): 처음 실행할 때 앱 폴더\resource로 복사 -->
    <AndroidAsset Include="..\AdlibComposer.App\Defaults\resource\STANDARD.BNK" Link="Assets\resource\STANDARD.BNK" />
    <AndroidAsset Include="..\AdlibComposer.App\Defaults\resource\GENMIDI.OP2" Link="Assets\resource\GENMIDI.OP2" />
    <AndroidAsset Include="..\AdlibComposer.App\Defaults\resource\GENMIDI.OP2.LICENSE.txt" Link="Assets\resource\GENMIDI.OP2.LICENSE.txt" />
    <AndroidAsset Include="..\AdlibComposer.App\Defaults\resource\systems.json" Link="Assets\resource\systems.json" />
    <!-- 데모 곡 (저장소 samples) -->
    <AndroidAsset Include="..\..\samples\demo.rol" Link="Assets\demo\demo.rol" />
    <AndroidAsset Include="..\..\samples\demo.bnk" Link="Assets\demo\demo.bnk" />
  </ItemGroup>
</Project>
