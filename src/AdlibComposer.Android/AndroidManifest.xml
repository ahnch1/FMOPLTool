<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- 곡 폴더 읽기: 안드로이드 10 이하 = 읽기 권한, 11 이상 = 모든 파일 접근 (개인용, 스토어에 올리지 않음) -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
  <!-- 화면이 꺼져도 재생: 전경 서비스 (알림) + 부분 wake lock -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <application android:allowBackup="false" android:icon="@mipmap/appicon" android:label="@string/app_name" android:supportsRtl="true" android:requestLegacyExternalStorage="true">
  </application>
</manifest>
